# Node
node_modules/
.pnp/
.pnp.js
.npm/
.yarn/
.eslintcache

# Build output
dist/
build/
out/
*.tsbuildinfo
# tsc -b emit from the composite vite-config project (emitDeclarationOnly).
# Regenerated on every typecheck / build; never want it in the tree.
apps/desktop/vite.config.d.ts

# Vite
.vite/

# Rust / Cargo
target/
**/*.rs.bk
*.pdb

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/WixTools/

# Project caches
.vproj/cache/
**/raster-cache/
**/proxy-cache/

# Editor / IDE
.claude/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.iml
.fleet/
.zed/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Env / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ffmpeg-sidecar download cache
**/.ffmpeg-sidecar/

# E2E (WebDriver): msedgedriver is downloaded + version-matched at runtime
apps/desktop/e2e/.drivers/

# Generated e2e media fixtures (regenerated by fixtures/generate-fixtures.mjs)
apps/desktop/e2e/fixtures/media/*
!apps/desktop/e2e/fixtures/media/.gitkeep

# Playwright MCP page-snapshot artifacts
.playwright-mcp/

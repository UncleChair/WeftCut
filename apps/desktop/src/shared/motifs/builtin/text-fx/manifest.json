{
  "id": "text-fx",
  "name": "Text FX",
  "version": 1,
  "size": [1920, 1080],
  "default_duration_s": 5.0,
  "settle_rafs": 1,
  "fonts": [{ "family": "Inter", "file": "Inter.woff2", "weight": 700 }],
  "props_schema": {
    "effect": {
      "type": "enum",
      "default": "karaoke",
      "options": ["typewriter", "karaoke", "color-shift"]
    },
    "text": {
      "type": "string",
      "default": "Your text here",
      "max_length": 200,
      "multiline": true
    },
    "font": {
      "type": "enum",
      "default": "sans-latin",
      "options": ["sans-latin"]
    },
    "font_size": { "type": "number", "default": 72, "min": 8, "max": 400 },
    "color": { "type": "color", "default": "#ffffff" },
    "color2": { "type": "color", "default": "#ffcc00" },
    "h_align": {
      "type": "enum",
      "default": "center",
      "options": ["left", "center", "right"]
    },
    "v_align": {
      "type": "enum",
      "default": "bottom",
      "options": ["top", "middle", "bottom"]
    },
    "outline_color": { "type": "color", "default": "#000000" },
    "outline_width": { "type": "number", "default": 4, "min": 0, "max": 30 },
    "bg_color": { "type": "color", "default": "#00000000" },
    "type_speed": { "type": "number", "default": 20, "min": 1, "max": 100 },
    "loop": {
      "type": "enum",
      "default": "once",
      "options": ["once", "loop", "pingpong"]
    }
  }
}

{
  "name": "@weftcut/desktop",
  "version": "0.0.0",
  "description": "WeftCut video editor desktop app",
  "homepage": "https://github.com/UncleChair/WeftCut",
  "author": {
    "name": "UncleChair",
    "email": "voidgun1998@gmail.com"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "npm run build:wasm",
    "build": "electron-vite build",
    "prebuild": "npm run build:wasm",
    "build:wasm": "node scripts/build-eval-wasm.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "pretypecheck": "npm run build:wasm",
    "test": "vitest run --exclude '**/*.browser.test.ts'",
    "pretest": "npm run build:wasm",
    "test:watch": "vitest --exclude '**/*.browser.test.ts'",
    "napi:build": "napi build --platform --release --manifest-path native/Cargo.toml --output-dir native --features jobs,export,mcp,cloud",
    "e2e:electron": "playwright test -c playwright.config.ts",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "package": "npm run napi:build && npm run build && electron-builder --publish never",
    "pbt:stryker": "stryker run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pixi/react": "^8.0.5",
    "@tailwindcss/vite": "^4.3.0",
    "@weftcut/core": "file:native",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.8",
    "lucide-react": "^1.17.0",
    "mediabunny": "^1.45.4",
    "pixi.js": "^8.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "@playwright/test": "^1.61.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "fast-check": "^4.8.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "shadcn": "^4.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}

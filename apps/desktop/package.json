{
  "name": "@weftcut/desktop",
  "version": "0.0.0",
  "description": "WeftCut video editor desktop app",
  "homepage": "https://github.com/UncleChair/WeftCut",
  "author": {
    "name": "UncleChair",
    "email": "voidgun1998@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "npm run electron:install && npm run ffmpeg:fetch && npm run ffmpeg:fetch-lgpl && npm run napi:build && npm run napi:build:decode",
    "electron:install": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "predev": "npm run build:wasm",
    "build": "electron-vite build",
    "prebuild": "npm run build:wasm",
    "build:e2e": "node scripts/build-e2e.mjs",
    "build:wasm": "node scripts/build-eval-wasm.mjs",
    "gen:icons": "electron scripts/gen-icons.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "pretypecheck": "npm run build:wasm",
    "test": "vitest run --exclude '**/*.browser.test.ts'",
    "pretest": "npm run build:wasm",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:watch": "vitest --exclude '**/*.browser.test.ts'",
    "napi:build": "napi build --platform --release --manifest-path native/Cargo.toml --output-dir native",
    "napi:build:decode": "node scripts/napi-build-decode.mjs",
    "mcp:catalog:snapshot": "node scripts/snapshot-mcp-catalog.mjs",
    "mcp:catalog:check": "node scripts/snapshot-mcp-catalog.mjs && git diff --exit-code fixtures/mcp/rust-catalog-snapshot.json",
    "e2e": "node scripts/run-e2e.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "ffmpeg:fetch-lgpl": "node scripts/fetch-ffmpeg-lgpl.mjs",
    "package": "npm run napi:build && npm run napi:build:decode && npm run build && electron-builder --publish never",
    "pbt:stryker": "stryker run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pixi/react": "^8.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@weftcut/core": "file:native",
    "@weftcut/native-decode": "file:native/decode",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "7.0.4",
    "express": "^5.2.1",
    "fuzzysort": "^3.1.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.15",
    "lucide-react": "^1.27.0",
    "mediabunny": "^1.51.0",
    "pinyin-pro": "^3.28.2",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.1",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "shadcn": "^4.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}

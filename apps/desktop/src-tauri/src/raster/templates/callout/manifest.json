{
  "id": "callout",
  "name": "Callout",
  "version": 1,
  "size": [1920, 1080],
  "default_duration_s": 3.0,
  "props_schema": {
    "text": {
      "type": "string",
      "default": "Note",
      "max_length": 160
    },
    "x_percent": {
      "type": "number",
      "default": 50.0,
      "min": 0.0,
      "max": 100.0
    },
    "y_percent": {
      "type": "number",
      "default": 50.0,
      "min": 0.0,
      "max": 100.0
    },
    "color": {
      "type": "color",
      "default": "#ffcc00"
    }
  }
}

{
  "id": "progress-bar",
  "name": "Progress Bar",
  "version": 1,
  "size": [1920, 80],
  "default_duration_s": 2.0,
  "props_schema": {
    "percent": {
      "type": "number",
      "default": 100.0,
      "min": 0.0,
      "max": 100.0
    },
    "color": {
      "type": "color",
      "default": "#3ad29f"
    },
    "label": {
      "type": "string",
      "default": "",
      "max_length": 60
    }
  }
}

{
  "id": "countdown",
  "name": "Countdown",
  "version": 1,
  "size": [480, 480],
  "default_duration_s": 5.0,
  "max_duration_s": 5.0,
  "max_duration_prop": "seconds",
  "engine": "svg",
  "props_schema": {
    "seconds": {
      "type": "number",
      "default": 5.0,
      "min": 1.0,
      "max": 60.0
    },
    "label": {
      "type": "string",
      "default": "GO",
      "max_length": 12
    },
    "accent": {
      "type": "color",
      "default": "#ff4d4d"
    }
  }
}

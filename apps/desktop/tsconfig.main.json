{
  // Electron MAIN process + the electron-vite config. Deliberately NO `DOM`
  // lib: the main process has no document/window, so accidental DOM use here is
  // now a type error (preload, which DOES run in the renderer's DOM context, has
  // its own tsconfig.preload.json). Web-platform globals the main process does
  // use legitimately (Response/ReadableStream/URL for the weftcut-media
  // protocol) come from @types/node, not DOM.
  //
  // `references: tsconfig.web.json` + `disableSourceOfProjectReferenceRedirect`
  // lets the import of src/renderer/eval resolve to web's emitted .d.ts (which
  // has no WebAssembly/atob uses) instead of re-type-checking renderer source
  // under main's lib set.
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // composite requires emit; redirect .d.ts out of source (TS6310).
    "emitDeclarationOnly": true,
    "declarationDir": "node_modules/.cache/tsc/main",
    "types": ["node"],
    // Resolve cross-project imports (renderer/eval) to web's emitted .d.ts,
    // not the renderer source — avoids pulling web-platform types into main.
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/cli/**/*.ts"],
  "references": [{ "path": "./tsconfig.web.json" }, { "path": "./tsconfig.shared.json" }]
}

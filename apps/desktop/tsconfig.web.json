{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@tauri-apps/api/core": ["./src/renderer/electron-compat/tauri-core.ts"],
      "@tauri-apps/api/event": ["./src/renderer/electron-compat/tauri-event.ts"],
      "@tauri-apps/api/path": ["./src/renderer/electron-compat/tauri-path.ts"],
      "@tauri-apps/api/window": ["./src/renderer/electron-compat/tauri-window.ts"],
      "@tauri-apps/api/webviewWindow": ["./src/renderer/electron-compat/tauri-webview-window.ts"],
      "@tauri-apps/plugin-dialog": ["./src/renderer/electron-compat/plugin-dialog.ts"],
      "@tauri-apps/plugin-fs": ["./src/renderer/electron-compat/plugin-fs.ts"],
      "@tauri-apps/plugin-notification": ["./src/renderer/electron-compat/plugin-notification.ts"],
      "@tauri-apps/plugin-shell": ["./src/renderer/electron-compat/plugin-shell.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    // composite requires emit; redirect .d.ts out of source (TS6310).
    "emitDeclarationOnly": true,
    "declarationDir": "node_modules/.cache/tsc/web"
  },
  "include": ["src/renderer", "fixtures/**/*.json"]
}

# napi-rs addon build output (rebuilt locally / in CI)
native/*.node
native/index.js
native/index.d.ts
native/decode/*.node
native/decode/index.js
native/decode/index.d.ts
# Co-located LGPL shared libs (staged next to the .node by napi-build-decode.mjs)
native/decode/*.so
native/decode/*.so.*
native/decode/*.dylib

# Playwright-for-Electron e2e output (transient; S3b+)
test-results/
playwright-report/

# ffmpeg binaries (fetched in CI / Task 2; not committed)
resources/ffmpeg/*/ffmpeg*
resources/ffmpeg/*/ffprobe*
resources/ffmpeg/*/ffplay*

# BtbN LGPL shared ffmpeg build (fetched by fetch-ffmpeg-lgpl.mjs, Task 3):
# bin/+include/+lib/+manifest.json are all download artifacts, never committed.
resources/ffmpeg-lgpl/

# electron-builder output (transient build artifacts)
release/

# electron-builder buildResources: the root .gitignore ignores all build/ dirs,
# but committed icon source assets live here. Re-include just those.
!build/
build/*
!build/icon.png

# determinism-artifacts/ — per-OS PNG captures; compared in CI (Task 8), never committed
determinism-artifacts/

# tsc -b declaration output for composite project refs (type-check only)
node_modules/.cache/tsc/

# dead plain-Vite output (build system removed)
dist/

# weftcut-eval wasm module: base64 of the wasm bytes, regenerated by
# scripts/build-eval-wasm.mjs (build:wasm). Build artifact, never committed.
src/renderer/eval/evalWasm.generated.ts

# StrykerJS mutation-testing output (pbt:stryker) — transient, never committed.
# reports/ = HTML+JSON mutation report; .stryker-tmp/ = per-mutant sandbox.
reports/
.stryker-tmp/

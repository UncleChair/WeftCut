{
  "name": "weftcut",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop video editor with an MCP tool surface for external AI agents",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "npm --workspace apps/desktop run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@wdio/cli": "^9.28.0"
  }
}
